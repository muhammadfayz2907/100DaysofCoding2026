public class Day03 {
  public static void main(String[] args) {

 // Penggunaan Escape Sequence (\n, \t, dan lain lain).

 /*
Escape sequence dalam Java adalah kombinasi karakter khusus yang diawali dengan tanda garis miring terbalik (\) untuk menampilkan karakter khusus atau mengatur format teks di dalam string.
 */

//Beberapa contohnya:

System.out.println("---BIODATA DIRI---");

// Menggunakan \n (Newline) untuk baris baru
System.out.println("MahaSiswa\nMuhammadFaiz");

System.out.println("");
    
// Menggunakan \t untuk tab
System.out.println("Umur:\t Sembilan belas");
System.out.println("Hobi:\t -Olahraga\n\t-Lari\n\t-Ngegym");

System.out.println("");

// Menggunakan \" (Double Quote) untuk kutip ganda
System.out.println("Cid Kagenao mengatakan, \"IAM ATOMIC!\"");

System.out.println("");

// Menggunakan \' (Single Quote) untuk kutip tunggal 
System.out.println("Cid Kagenao dikenal sebagai Master yang suka \'coin\' meskipun kekuatannya belum di ketahui bagaimana.");

 
  }
}
